# MongoDB connection string (MongoDB Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bloomandyou

# Sites allowed to call the API, comma separated. Empty allows all.
CORS_ORIGIN=https://bloom-and-you-app.vercel.app,http://localhost:5173

# Local port only (Vercel ignores it)
PORT=5000

# Optional: email each contact message to you (resend.com, free)
RESEND_API_KEY=
# The inbox that receives them. On Resend's free sender this must be the email you signed up to Resend with.
CONTACT_TO=
